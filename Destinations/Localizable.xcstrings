          }
        }
      }
    },
    "Turn off app lock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف قفل التطبيق"
          }
        }
      }
    },
    "Turn on app lock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل قفل التطبيق"
          }
        }
      }
    },
    "Turns the postcard over": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقلب البطاقة البريدية"
          }
        }
      }
    },
    "Turns the slow, endless 3D spin of the photo on the destination screen on or off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل أو يوقف الدوران البطيء ثلاثي الأبعاد لصورة الوجهة."
          }
        }
      }
    },
    "Use the original color": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام اللون الأصلي"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار %1$@ (%2$@)"
          }
        }
      }
    },
    "When the lock is on, the app asks for your PIN every time you open it or come back to it. A forgotten PIN can't be recovered; the only way back in is to erase all data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تشغيل القفل، يطلب التطبيق رمزك في كل مرة تفتحه فيها أو تعود إليه. لا يمكن استعادة الرمز المنسي، والطريقة الوحيدة للدخول هي مسح كل البيانات."
          }
        }
      }
    },
    "Where have you been?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين كنت؟"
          }
        }
      }
    },
    "Wrong PIN. %lld tries left before a delay.": {
      "localizations": {
        "en": {
          "variations": {
