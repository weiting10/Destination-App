        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمزان غير متطابقين. يُرجى اختيار رمز من جديد."
          }
        }
      }
    },
    "The privacy policy couldn't be loaded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل سياسة الخصوصية."
          }
        }
      }
    },
    "There is no way to recover a forgotten PIN. This deletes all your places, photos and notes, and turns the lock off. It can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد طريقة لاستعادة الرمز المنسي. سيؤدي هذا إلى حذف كل أماكنك وصورك وملاحظاتك وإيقاف القفل. لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
    "To": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى"
          }
        }
      }
    },
    "To: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى: %@"
          }
        }
      }
    },
    "Too many tries. Try again in %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة. حاول مرة أخرى بعد %@."
          }
        }
      }
    },
    "Toronto": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تورونتو"
          }
        }
      }
    },
    "Travel Diary": {
      "localizations": {
