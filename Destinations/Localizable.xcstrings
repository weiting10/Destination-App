                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wrong PIN. %lld tries left before a delay."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "رمز خاطئ. لم تتبقَّ محاولات قبل التأخير."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "رمز خاطئ. تبقّت محاولة واحدة قبل التأخير."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "رمز خاطئ. تبقّت محاولتان قبل التأخير."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "رمز خاطئ. تبقّت %lld محاولات قبل التأخير."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "رمز خاطئ. تبقّت %lld محاولة قبل التأخير."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "رمز خاطئ. تبقّت %lld محاولة قبل التأخير."
                }
              }
            }
